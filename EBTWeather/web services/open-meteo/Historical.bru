meta {
  name: Historical
  type: http
  seq: 2
}

get {
  url: https://historical-forecast-api.open-meteo.com/v1/forecast?latitude={{latitude}}&longitude={{longitude}}&elevation={{elevation}}&timezone={{timezone}}&start_date={{start_date}}&end_date={{end_date}}&daily=weather_code,uv_index_max,temperature_2m_max,temperature_2m_min,apparent_temperature_min,apparent_temperature_max,sunrise,sunset,daylight_duration,sunshine_duration,precipitation_sum,rain_sum,showers_sum,snowfall_sum,precipitation_sum,precipitation_hours,wind_speed_10m_max,wind_gusts_10m_max,wind_direction_10m_dominant
  body: none
  auth: inherit
}

params:query {
  latitude: {{latitude}}
  longitude: {{longitude}}
  elevation: {{elevation}}
  timezone: {{timezone}}
  start_date: {{start_date}}
  end_date: {{end_date}}
  daily: weather_code,uv_index_max,temperature_2m_max,temperature_2m_min,apparent_temperature_min,apparent_temperature_max,sunrise,sunset,daylight_duration,sunshine_duration,precipitation_sum,rain_sum,showers_sum,snowfall_sum,precipitation_sum,precipitation_hours,wind_speed_10m_max,wind_gusts_10m_max,wind_direction_10m_dominant
}

vars:pre-request {
  start_date: 2026-02-09
  end_date: 2026-02-18
}

settings {
  encodeUrl: true
  timeout: 0
}
